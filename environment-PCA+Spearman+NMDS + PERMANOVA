  "202510"
)



# ======================================================================
# 4. 环境 PCA
#
# 保持原代码：
# Z-score标准化 + rda PCA
# ======================================================================

pca_env <- rda(
  scale(
    env_df[, 1:ncol(env_df)-1]
  )
)



# ======================================================================
# 5. 提取 PCA 数据
# ======================================================================

site <- as.data.frame(
  scores(
    pca_env,
    display = "sites",
    scaling = 2
  )
)


colnames(site) <- c(
  "PC1",
  "PC2"
)


site$Group <- env_df$Group



# ======================================================================
# 6. 环境因子箭头
# ======================================================================

arrow <- as.data.frame(
  scores(
    pca_env,
    display = "species",
    scaling = 2
  )
)


arrow$Var <- rownames(arrow)


colnames(arrow)[1:2] <- c(
  "PC1",
  "PC2"
)



# ======================================================================
# 7. PCA解释率
# ======================================================================

expl <- summary(pca_env)$cont$importance[2, 1:2]


lab1 <- paste0(
  "PC1 (",
  round(expl[1] * 100, 2),
