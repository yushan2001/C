# ======================================================================

sample_cols <- c(
  
  "04DC",
  "04JH",
  "04MH",
  "04RC",
  "04SX",
  "04TC",
  "04TJ",
  
  "10DC",
  "10JH",
  "10MH",
  "10RC",
  "10SX",
  "10TC",
  "10TJ"
)



# ======================================================================
# 21. 环境因子水平数据处理
# ======================================================================

df_env <- df %>%
  
  filter(
    !is.na(指标) &
      指标 != ""
  ) %>%
  
  select(
    指标,
    all_of(sample_cols)
  ) %>%
  
  as.data.frame()



# ======================================================================
# 22. 构建矩阵
#
# 行 = samples
# 列 = environmental factors
#
# 和原代码逻辑完全一致
# ======================================================================

rownames(df_env) <- df_env$指标


df_matrix <- df_env[
  ,
  -1,
  drop = FALSE
]



# 缺失值填充为0
df_matrix[
  is.na(df_matrix)
] <- 0



# 转置为：
# 样本 × 环境因子

df_transposed <- t(
  df_matrix
)



# ======================================================================
# 23. NMDS
#
# 参数保持原代码完全一致：
#
# set.seed = 42
# distance = Bray
# k = 2
# trymax = 100
#
# 不额外修改 autotransform
# ======================================================================

set.seed(42)


nmds_result <- metaMDS(
  
  df_transposed,
  
  distance = "bray",
  
  k = 2,
  
  trymax = 100
)



# ======================================================================
# 24. 提取坐标 + 分组
# ======================================================================

nmds_coords <- as.data.frame(
  
  scores(
    nmds_result,
    display = "sites"
  )
)



nmds_coords$Time <- ifelse(
  
  grepl(
    "^04",
    rownames(nmds_coords)
  ),
  
  "April 2025",
  
  "October 2025"
)



group_factor <- factor(
  nmds_coords$Time
)



# ======================================================================
# 25. PERMANOVA
#
# 保持你的原始代码：
#
# Bray-Curtis
# 999 unrestricted permutations
# ======================================================================

adonis_result <- adonis2(
  
  df_transposed ~ group_factor,
  
  data = nmds_coords,
  
  method = "bray",
  
  permutations = 999
)



adonis_r2 <- round(
  
  adonis_result$R2[1],
  
  4
)



adonis_p <- round(
  
  adonis_result$`Pr(>F)`[1],
  
  4
)



# ======================================================================
# 26. 分组凸包
#
# 保持原代码
# ======================================================================

calculate_hull <- function(data){
  
  data[
    
    chull(
      data$NMDS1,
      data$NMDS2
    ),
    
  ]
}



hull_data <- nmds_coords %>%
  
  group_by(
    Time
  ) %>%
  
  do(
    calculate_hull(.)
  )



